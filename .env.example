# Copy to .env. Never commit actual credentials.
ConnectionStrings__Workout="Host=192.168.0.48;Port=5432;Database=workout;Username=workout_app;Password=replace-me"
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
PUBLIC_HOSTNAME=workout.example.com
TUNNEL_TOKEN=

# Web Push: generate once with the --generate-vapid command; preserve the key pair.
Notifications__Enabled=false
Notifications__PublicKey=
Notifications__PrivateKey=
Notifications__Subject=mailto:you@example.com
